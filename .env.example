# Copy this file to .env and fill in the values.
# .env is git-ignored; never commit real credentials.

POSTGRES_USER=itihasa
POSTGRES_PASSWORD=changeme
POSTGRES_DB=itihasa
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://itihasa:changeme@localhost:5433/itihasa

# Used in HTTP User-Agent strings for all outbound API requests.
# Format: Itihasa/0.1 (+https://github.com/Akchhya1108/Itihasa; <your email>)
ITIHASA_CONTACT_EMAIL=your-email@example.com

# Optional: Zenodo API key for authenticated requests (100 req/min vs 60 for anonymous).
# Create a free token at https://zenodo.org/account/settings/applications/tokens/new/
ZENODO_API_KEY=
